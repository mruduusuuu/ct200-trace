# --- SQL (tree, versions, selections) ---
DATABASE_URL=sqlite:///./data/ct200.db

# --- NoSQL (generated output): json (default, zero-dependency) | mongo ---
STORE_BACKEND=json
JSON_STORE_DIR=./data/generations
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ct200

# --- LLM: openai_compat (Groq / OpenRouter / Gemini-OpenAI endpoint) | mock (offline demo only) ---
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_JSON_MODE=true
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_S=60
MAX_SOURCE_CHARS=20000

# --- version matcher ---
MATCH_FUZZY_THRESHOLD=0.72
